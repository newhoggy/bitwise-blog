// The leak check CI can run: the same comparison as `leak-check`, against a committed list of keyed hashes of the
// private runs instead of the private text. See corpus/README.md and docs/leak-check-in-ci.html.
//
// Each run (as `privateRuns` in guards.mts builds it) is HMAC-SHA256(key, run), truncated to 64 bits. The key is a
// GitHub Actions secret, so the list confirms nothing about a guessed phrase to anyone without it. The list is
// padded with entries derived from the key up to a power of two, so its size says little about the corpus. The text
// a blob holds is read by `findRuns`, the same function the local check uses: only the membership test differs.

import { execFileSync, spawnSync } from "node:child_process";
import { createHash, createHmac, createSecretKey, type KeyObject } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { CORPUS_DIR, privateDir } from "./corpus.mts";
import { LEAK_ALLOWED, compareRevs, privateRuns, runsDigest, type BlobComparison, type LeakAllowance } from "./guards.mts";

/** The committed list, in corpus/. */
export const LEAK_HASHES_FILE = "leak-hashes.txt";
/** Where the generator records what the list was made from: in the private data, never in this repo. */
export const LEAK_STAMP_FILE = "leak-hashes.stamp.json";
/** The environment variable (and GitHub Actions secret) that holds the key. */
export const LEAK_KEY_ENV = "BH_LEAK_KEY";
/** The owner's copy of the key: a Password item with this title in the vault $BH_OP_VAULT (default "Private"). */
export const LEAK_KEY_ITEM = "beautiful-html leak-check key";
/** A shorter key is a mistake (an empty or truncated secret), not a key. */
export const MIN_KEY_LENGTH = 32;
/** The fewest entries a list has, padding included, so a small corpus doesn't show as one. */
export const MIN_ENTRIES = 4096;

const FORMAT = "bh-leak-hashes/1";
// Labels hashed for the key check and the padding hold "/" and ":", which no run (words joined by spaces) can.
const KEY_CHECK_LABEL = `${FORMAT}:key-check`;
const PAD_LABEL = `${FORMAT}:pad:`;
const HEX16 = /^[0-9a-f]{16}$/;

export const leakHashesPath = (corpusRoot: string = CORPUS_DIR) => path.join(corpusRoot, LEAK_HASHES_FILE);
export const leakStampPath = (corpusRoot: string = CORPUS_DIR) => path.join(privateDir(corpusRoot), LEAK_STAMP_FILE);

/** The key as Node's crypto wants it, refusing one too short to be real. The message never holds the key. */
export function leakKey(secret: string): KeyObject {
  if (secret.trim().length < MIN_KEY_LENGTH) throw new Error(`the leak-check key is shorter than ${MIN_KEY_LENGTH} characters, so it is not a real key`);
  return createSecretKey(Buffer.from(secret.trim(), "utf8"));
}

/** HMAC-SHA256 of `text` under `key`, truncated to 64 bits, as 16 hex digits. */
export const runHash = (key: KeyObject, text: string): string => createHmac("sha256", key).update(text).digest("hex").slice(0, 16);

/** The number of entries a list of `real` distinct runs is padded to: the next power of two, and at least `min`. */
export function paddedSize(real: number, min: number = MIN_ENTRIES): number {
  let size = 1;
  while (size < Math.max(real, min)) size *= 2;
  return size;
}

/**
 * The list file for `runs`: a format line, a comment, the key check, then one hash per line, sorted. Padding is
 * HMAC of a counter, so it can't be told from a run without the key, and regenerating after a small change to the
 * corpus rewrites few lines.
 */
export function renderHashList(runs: Iterable<string>, key: KeyObject, min: number = MIN_ENTRIES): string {
  return buildHashList(runs, key, min).text;
}

/** The list file for `runs`, and how many entries it holds (padding included). */
function buildHashList(runs: Iterable<string>, key: KeyObject, min: number): { text: string; entries: number } {
  const hashes = new Set<string>();
  for (const run of runs) hashes.add(runHash(key, run));
  const size = paddedSize(hashes.size, min);
  for (let i = 0; hashes.size < size; i++) hashes.add(runHash(key, PAD_LABEL + i));
  const text = [
    FORMAT,
    "# Keyed hashes (HMAC-SHA256, 64 bits) of the 8-word runs of the private data, padded. Meaningless without the key.",
    "# Generated by `npm run advisor -- leak-hashes`; never edit by hand. See corpus/README.md.",
    `key-check ${runHash(key, KEY_CHECK_LABEL)}`,
    ...[...hashes].sort(),
    "",
  ].join("\n");
  return { text, entries: hashes.size };
}

export interface HashList { keyCheck: string; hashes: Set<string> }

/** Parse a list file. Errors name the line, never its content. */
export function parseHashList(text: string): HashList {
  const lines = text.split("\n");
  if (lines[0] !== FORMAT) throw new Error(`${LEAK_HASHES_FILE} does not start with "${FORMAT}"`);
  let keyCheck: string | undefined;
  const hashes = new Set<string>();
  lines.forEach((line, index) => {
    if (index === 0 || line === "" || line.startsWith("#")) return;
    const check = /^key-check ([0-9a-f]{16})$/.exec(line);
    if (check && keyCheck === undefined) keyCheck = check[1];
    else if (HEX16.test(line)) hashes.add(line);
    else throw new Error(`${LEAK_HASHES_FILE} line ${index + 1} is neither a hash nor the key check`);
  });
  if (keyCheck === undefined) throw new Error(`${LEAK_HASHES_FILE} has no key-check line`);
  return { keyCheck, hashes };
}

/**
 * A `RunSet` backed by the list: it holds a run when the run's hash is listed. Throws when `key` is not the key the
 * list was made with, since every lookup would then miss and the check would pass having compared nothing.
 */
export function hashedRuns(list: HashList, key: KeyObject): { has(run: string): boolean } {
  if (runHash(key, KEY_CHECK_LABEL) !== list.keyCheck) throw new Error(`the leak-check key does not match ${LEAK_HASHES_FILE}: it was made with another key, so regenerate it (\`npm run advisor -- leak-hashes\`) or set the matching secret`);
  return { has: (run) => list.hashes.has(runHash(key, run)) };
}

/** What the generator records about a list, in the private data. */
interface LeakStamp { format: string; runs: string; list: string }

const sha256 = (bytes: string | Buffer) => createHash("sha256").update(bytes).digest("hex");

/** Write corpus/leak-hashes.txt from the private data, and the stamp beside the private data. Returns the number of entries. */
export function writeLeakHashes(secret: string, corpusRoot: string = CORPUS_DIR, min: number = MIN_ENTRIES): number {
  const key = leakKey(secret);
  const found = privateRuns(corpusRoot);
  if (!found) throw new Error("no posts, atlas, voice negatives or authored samples in the private data, so there is nothing to hash; is corpus/private linked?");
  const { text, entries } = buildHashList(found.runs.keys(), key, min);
  fs.writeFileSync(leakHashesPath(corpusRoot), text);
  const stamp: LeakStamp = { format: FORMAT, runs: runsDigest(found.runs.keys()), list: sha256(text) };
  fs.writeFileSync(leakStampPath(corpusRoot), JSON.stringify(stamp, null, 2) + "\n");
  return entries;
}

/** The list as committed at `rev` in `repoRoot`, or null when that commit has none. */
function committedList(repoRoot: string, rev: string, corpusRoot: string): Buffer | null {
  const rel = path.relative(repoRoot, leakHashesPath(corpusRoot)).split(path.sep).join("/");
  const shown = spawnSync("git", ["-C", repoRoot, "show", `${rev}:${rel}`], { maxBuffer: 1024 * 1024 * 1024 });
  return shown.status === 0 ? shown.stdout : null;
}

/**
 * Whether the list committed at HEAD is current, judged without the key: "absent" when there is no list at all,
 * "uncommitted" when the file on disk differs from HEAD's (regenerated but not committed), "unknown" when the private
 * data has no stamp (the list was made elsewhere), "stale" when the corpus or the list has changed since the stamp
 * was written. `digest` is `runsDigest` of the private runs now.
 */
export function hashListStatus(digest: () => string, repoRoot: string, corpusRoot: string = CORPUS_DIR): "absent" | "uncommitted" | "unknown" | "stale" | "current" {
  const listFile = leakHashesPath(corpusRoot);
  const onDisk = fs.existsSync(listFile) ? fs.readFileSync(listFile) : null;
  const committed = committedList(repoRoot, "HEAD", corpusRoot);
  if (!onDisk && !committed) return "absent";
  if (!onDisk || !committed || !onDisk.equals(committed)) return "uncommitted";
  let stamp: Partial<LeakStamp>;
  try {
    stamp = JSON.parse(fs.readFileSync(leakStampPath(corpusRoot), "utf8")) as Partial<LeakStamp>;
  } catch {
    return "unknown";
  }
  return stamp.format === FORMAT && stamp.list === sha256(committed) && stamp.runs === digest() ? "current" : "stale";
}

export type LeakKeyResult = { key: string; error?: undefined } | { error: string; key?: undefined };

/** The key for the generator: $BH_LEAK_KEY, else the owner's 1Password item. `readItem` is injectable for tests. */
export function resolveLeakKey({ env = process.env, readItem = readOpItem }: { env?: NodeJS.ProcessEnv; readItem?: (title: string, vault: string) => string } = {}): LeakKeyResult {
  const fromEnv = (env[LEAK_KEY_ENV] || "").trim();
  if (fromEnv) return { key: fromEnv };
  const vault = env["BH_OP_VAULT"] || "Private";
  let why = "";
  try {
    const fromOp = (readItem(LEAK_KEY_ITEM, vault) || "").trim();
    if (fromOp) return { key: fromOp };
    why = " (the 1Password item is empty)";
  } catch (err) {
    const e = err as NodeJS.ErrnoException & { stderr?: string };
    if (e.code !== "ENOENT") why = ` (1Password: ${String(e.stderr || e.message).trim().split("\n")[0]})`;
  }
  return { error: `no leak-check key${why}: set ${LEAK_KEY_ENV}, or store the key in 1Password as a Password item titled "${LEAK_KEY_ITEM}" in the vault "${vault}"` };
}

/** The password field of a 1Password item. The secret travels on stdout only. */
function readOpItem(title: string, vault: string): string {
  return execFileSync("op", ["item", "get", title, "--vault", vault, "--fields", "label=password", "--reveal"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], timeout: 60_000 });
}

/** Why the hashed check compared nothing: there is no secret, which is expected for a fork's pull request. */
export type HashedSkip = { status: "skipped"; level: "notice"; reason: string };

export type HashedResult = HashedSkip | ({ status: "done"; /** Set when a base was given but is not a commit in this clone (a force push), so everything reachable from the head was read. */ baseUnknown: boolean } & BlobComparison);

/** The commit `rev` names, as a full id, or null. `--end-of-options` keeps a value such as `--all` from being read as an option. */
function resolveCommit(repoRoot: string, rev: string): string | null {
  const r = spawnSync("git", ["-C", repoRoot, "rev-parse", "--verify", "-q", "--end-of-options", `${rev}^{commit}`], { encoding: "utf8" });
  return r.status === 0 && /^[0-9a-f]{40,64}$/.test(r.stdout.trim()) ? r.stdout.trim() : null;
}

/**
 * CI's check: the blobs reachable from `head` but not from `base` (all of them reachable from `head` when `base` is
 * missing, zero or unknown here), compared with corpus/leak-hashes.txt under `secret`. The list is the one committed
 * at `base` when `base` has one, so a change that deletes or empties the list can't switch the check off for itself;
 * otherwise (the change that adds the list, or no base) it is the one checked out. The allowances are the local
 * check's, applied the same way. Skips, saying why, when there is no secret; with a secret and no list, it fails.
 */
export function leakCheckHashed(repoRoot: string, head: string, base: string | undefined, secret: string | undefined, corpusRoot: string = CORPUS_DIR, allowances: Record<string, LeakAllowance> = LEAK_ALLOWED): HashedResult {
  if (!secret?.trim()) return { status: "skipped", level: "notice", reason: `no ${LEAK_KEY_ENV} secret (a pull request from a fork, or the key is not set up yet), so nothing was compared; the run on main checks what this brings in once it is merged` };
  const key = leakKey(secret);
  const headSha = resolveCommit(repoRoot, head);
  if (!headSha) throw new Error("the head to check is not a commit in this clone");
  const given = base !== undefined && base !== "" && !/^0+$/.test(base);
  const baseSha = given ? resolveCommit(repoRoot, base) : null;
  const listFile = leakHashesPath(corpusRoot);
  const text = (baseSha && committedList(repoRoot, baseSha, corpusRoot)) ?? (fs.existsSync(listFile) ? fs.readFileSync(listFile) : null);
  if (!text) throw new Error(`${LEAK_KEY_ENV} is set but corpus/${LEAK_HASHES_FILE} is not committed, so nothing can be compared; generate it with \`npm run advisor -- leak-hashes\` and commit it`);
  const runs = hashedRuns(parseHashList(text.toString("utf8")), key);
  const revs = baseSha ? [headSha, "--not", baseSha] : [headSha];
  return { status: "done", baseUnknown: given && !baseSha, ...compareRevs(repoRoot, revs, runs, allowances) };
}
