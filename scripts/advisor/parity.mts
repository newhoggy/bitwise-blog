// `npm run advisor -- parity`: does the TypeScript port still agree with the Python code at af0b407?
//
// The reference is `<writer>/parity/` in the private data, written once by a tool kept there. So this
// needs the private data, and skips cleanly without it: CI never has it. Output is status lines only,
// with no text from the corpus, though a failing row may name a post stem.

import crypto from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { isDeepStrictEqual } from "node:util";
import { CORPUS_DIR, dataDir, loadMeta, loadPosts, metaPath, renderMeta, validate } from "./corpus.mts";
import { leakCheck } from "./guards.mts";
import { applyHoldout, computeHoldout } from "./holdout.mts";
import { renderWriterIndex, writers } from "./index.mts";
import { pyReadText } from "./py-compat.mts";

export interface ParityRow { check: string; status: "pass" | "fail" | "pending"; detail: string }

/** One post as the Python code at af0b407 read it. */
interface PostReference {
  stem: string;
  title: string;
  author: string;
  source: string;
  published: string;
  platform: string;
  meta: Record<string, unknown>;
  body_sha256: string;
}
interface Reference { commit: string; posts: PostReference[]; holdout: string[] }

const REGENERATED = /Regenerated by `[^`]+`\./;
const row = (check: string, ok: boolean, detail: string): ParityRow => ({ check, status: ok ? "pass" : "fail", detail });

function parityFile(slug: string, corpusRoot: string): string {
  return path.join(dataDir(slug, corpusRoot), "parity", "posts.json");
}

/** The rows for one writer. */
export function writerParity(slug: string, corpusRoot: string = CORPUS_DIR): ParityRow[] {
  const reference = JSON.parse(fs.readFileSync(parityFile(slug, corpusRoot), "utf8")) as Reference;
  const posts = loadPosts(slug, corpusRoot);
  const expected = new Map(reference.posts.map((p) => [p.stem, p]));
  const differing = posts.filter((p) => {
    const want = expected.get(p.stem);
    if (!want) return true;
    const got: PostReference = {
      stem: p.stem, title: p.title, author: p.author, source: p.source, published: p.published, platform: p.platform, meta: p.meta,
      body_sha256: crypto.createHash("sha256").update(p.body).digest("hex"),
    };
    return !isDeepStrictEqual(got, want);
  });
  const missing = reference.posts.filter((p) => !posts.some((q) => q.stem === p.stem));
  const order = isDeepStrictEqual(posts.map((p) => p.stem), reference.posts.map((p) => p.stem));

  const rows = [row(
    "Posts",
    differing.length === 0 && missing.length === 0 && order,
    `${posts.length} of ${reference.posts.length} posts agree${differing.length ? `; differ: ${differing.slice(0, 5).map((p) => p.stem).join(", ")}` : ""}`
      + `${missing.length ? `; missing: ${missing.slice(0, 5).map((p) => p.stem).join(", ")}` : ""}${order ? "" : "; order differs"}`,
  )];

  const meta = loadMeta(slug, corpusRoot);
  const chosen = computeHoldout(posts);
  rows.push(row(
    "Holdout",
    validate(slug, corpusRoot).length === 0 && isDeepStrictEqual([...chosen].sort(), [...reference.holdout].sort()) && isDeepStrictEqual(applyHoldout(meta, chosen), meta),
    `${chosen.size} eval posts`,
  ));

  const indexFile = path.join(dataDir(slug, corpusRoot), "INDEX.md");
  const normalise = (text: string | null) => (text ?? "").replace(REGENERATED, "Regenerated.");
  rows.push(row("INDEX.md", normalise(renderWriterIndex(slug, corpusRoot)) === normalise(pyReadText(indexFile)), "identical apart from the script name"));

  const sidecar = pyReadText(metaPath(slug, corpusRoot));
  rows.push(row("corpus_meta.yaml", renderMeta(meta, sidecar) === sidecar, "round-trips byte for byte"));
  return rows;
}

// What the private tier will cover once the phases that port these land. Kept here so the table in
// issue #110 stays visible, and so a phase that forgets its row shows up as still pending.
const PENDING: [check: string, phase: string][] = [
  ["items.jsonl", "Phase 5"],
  ["ATLAS.jsonl from saved results", "Phase 4"],
  ["Voice model", "Phase 5"],
  ["Retrieval", "Phase 6"],
  ["Stage-2 cache", "Phase 7"],
  ["Stance model", "Phase 7"],
];

export type ParityResult = { status: "skipped"; reason: string } | { status: "done"; rows: [writer: string, row: ParityRow][] };

export function parity(repoRoot: string, corpusRoot: string = CORPUS_DIR): ParityResult {
  const checked = writers(corpusRoot).filter((w) => fs.existsSync(parityFile(w, corpusRoot)));
  if (checked.length === 0) return { status: "skipped", reason: "no private data with a parity reference (see `npm run advisor -- link`)" };
  const rows: [string, ParityRow][] = checked.flatMap((w) => writerParity(w, corpusRoot).map((r): [string, ParityRow] => [w, r]));
  const leak = leakCheck(repoRoot, corpusRoot);
  if (leak.status === "done") {
    rows.push(["(all)", row("Leak check", leak.hits.length === 0, `${leak.quotes} quotes, ${leak.files} tracked files, ${leak.hits.length} runs found, ${leak.allowed.length} files allowed`)]);
  }
  for (const [check, phase] of PENDING) rows.push(["(all)", { check, status: "pending", detail: `not ported yet (${phase})` }]);
  return { status: "done", rows };
}
