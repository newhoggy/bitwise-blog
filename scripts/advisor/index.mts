// Regenerate the INDEX.md catalogues in the private data. A port of build_index.py.
//
//   <writer>/INDEX.md    post catalogue for a writer
//   thoughts/INDEX.md    topics, with status and confidence
//   library/INDEX.md     sources, with epistemic ratings

import fs from "node:fs";
import path from "node:path";
import { CORPUS_DIR, META_FILENAME, dataDir, loadMeta, markdownFiles, parseFrontmatter, privateDir, type Frontmatter, type PostMeta } from "./corpus.mts";
import { codePointCompare, pyStr, pyTruthy } from "./py-compat.mts";

const REGENERATED = "Regenerated by `npm run advisor -- index`.";

/** `fm.get(key) or ""`, as text. */
function field(fm: Frontmatter, key: string, fallback = ""): string {
  return pyTruthy(fm[key]) ? pyStr(fm[key]) : fallback;
}

const cellText = (s: string) => s.replaceAll("|", "\\|");

function corpusCell(entry: PostMeta): string {
  if (entry.split === "eval") return "eval";
  if (entry.atlas === "exclude") return `excluded: ${entry.atlas_reason === undefined ? "" : pyStr(entry.atlas_reason)}`.replaceAll("|", "\\|");
  return "";
}

/** `sorted(key=…, reverse=True)`: descending, with equal keys left in their original order. */
function newestFirst<T>(entries: T[], key: (entry: T) => string): T[] {
  return [...entries].sort((a, b) => codePointCompare(key(b), key(a)));
}

/** The text of a writer's INDEX.md, or null if the writer has no `posts/`. */
export function renderWriterIndex(slug: string, corpusRoot: string = CORPUS_DIR): string | null {
  const dir = dataDir(slug, corpusRoot);
  const postsDir = path.join(dir, "posts");
  if (!fs.existsSync(postsDir)) return null;
  const meta = loadMeta(slug, corpusRoot);
  const hasMeta = Object.keys(meta).length > 0;
  const entries = newestFirst(markdownFiles(postsDir).map((file) => {
    const fm = parseFrontmatter(file);
    const stem = path.basename(file, ".md");
    return {
      title: field(fm, "title", stem),
      published: field(fm, "published"),
      platform: field(fm, "platform"),
      source: field(fm, "source"),
      relPath: path.relative(dir, file).split(path.sep).join("/"),
      corpus: corpusCell(meta[stem] ?? {}),
    };
  }), (e) => e.published);

  const lines = [`# ${slug} — post index`, "", `_${entries.length} post(s). ${REGENERATED}_`, ""];
  if (hasMeta) {
    const nEval = entries.filter((e) => e.corpus === "eval").length;
    const nExcluded = entries.filter((e) => e.corpus.startsWith("excluded")).length;
    lines.push(`_Corpus: ${entries.length - nEval - nExcluded} in atlas, ${nEval} eval holdout, ${nExcluded} excluded (see \`${META_FILENAME}\`)._`, "");
  }
  if (entries.length) {
    if (hasMeta) lines.push("| Date | Platform | Title | Source | Corpus |", "| --- | --- | --- | --- | --- |");
    else lines.push("| Date | Platform | Title | Source |", "| --- | --- | --- | --- |");
    for (const e of entries) {
      const source = e.source ? `[link](${e.source})` : "";
      let row = `| ${e.published} | ${e.platform} | [${cellText(e.title)}](${e.relPath}) | ${source} |`;
      if (hasMeta) row += ` ${e.corpus} |`;
      lines.push(row);
    }
  } else lines.push("_No posts ingested yet._");
  return `${lines.join("\n")}\n`;
}

/** The text of thoughts/INDEX.md, or null if there is no thoughts directory. */
export function renderThoughtsIndex(corpusRoot: string = CORPUS_DIR): string | null {
  const dir = path.join(privateDir(corpusRoot), "thoughts");
  if (!fs.existsSync(dir)) return null;
  const topics = fs.readdirSync(dir, { withFileTypes: true })
    .filter((d) => d.isDirectory() && fs.existsSync(path.join(dir, d.name, "README.md")))
    .map((d) => d.name)
    .sort(codePointCompare);
  const entries = newestFirst(topics.map((name) => {
    const fm = parseFrontmatter(path.join(dir, name, "README.md"));
    return {
      title: field(fm, "title", name),
      status: field(fm, "status"),
      confidence: field(fm, "confidence"),
      lastUpdated: field(fm, "last_updated"),
      tags: pyTruthy(fm.tags) && Array.isArray(fm.tags) ? fm.tags.map(pyStr).join(", ") : "",
      relPath: `${name}/README.md`,
    };
  }), (e) => e.lastUpdated);

  const lines = ["# thoughts — topic index", "", `_${entries.length} topic(s). ${REGENERATED}_`, ""];
  if (entries.length) {
    lines.push("| Updated | Status | Confidence | Title | Tags |", "| --- | --- | --- | --- | --- |");
    for (const e of entries) lines.push(`| ${e.lastUpdated} | ${e.status} | ${e.confidence} | [${cellText(e.title)}](${e.relPath}) | ${e.tags} |`);
  } else lines.push('_No thoughts yet. Create one with `npm run advisor -- thought "<title>"`._');
  return `${lines.join("\n")}\n`;
}

/** Every `.md` below `dir`, in `sorted(rglob("*.md"))` order: path parts compared one by one. */
function markdownTree(dir: string): string[] {
  const found: string[][] = [];
  const walk = (parts: string[]) => {
    for (const entry of fs.readdirSync(path.join(dir, ...parts), { withFileTypes: true })) {
      const here = [...parts, entry.name];
      if (entry.isDirectory()) walk(here);
      else if (entry.name.endsWith(".md")) found.push(here);
    }
  };
  walk([]);
  found.sort((a, b) => {
    for (let i = 0; i < Math.min(a.length, b.length); i++) {
      const d = codePointCompare(a[i], b[i]);
      if (d) return d;
    }
    return a.length - b.length;
  });
  return found.map((parts) => parts.join("/"));
}

/** The text of library/INDEX.md, or null if there is no library directory. */
export function renderLibraryIndex(corpusRoot: string = CORPUS_DIR): string | null {
  const dir = path.join(privateDir(corpusRoot), "library");
  if (!fs.existsSync(dir)) return null;
  const rows = [];
  for (const relPath of markdownTree(dir)) {
    if (path.basename(relPath) === "INDEX.md") continue;
    const fm = parseFrontmatter(path.join(dir, relPath));
    if (Object.keys(fm).length === 0) continue;
    rows.push({
      title: field(fm, "title", path.basename(relPath, ".md")),
      author: field(fm, "author"),
      type: field(fm, "type"),
      agreement: field(fm, "my_agreement"),
      weight: field(fm, "evidential_weight"),
      source: field(fm, "source"),
      added: field(fm, "date_added"),
      relPath,
    });
  }
  const entries = newestFirst(rows, (e) => e.added);
  const lines = ["# library — source index", "", `_${entries.length} source(s). ${REGENERATED}_`, ""];
  if (entries.length) {
    lines.push("| Added | Type | Agreement | Weight | Title | Author | Source |", "| --- | --- | --- | --- | --- | --- | --- |");
    for (const e of entries) {
      const source = e.source ? `[link](${e.source})` : "";
      lines.push(`| ${e.added} | ${e.type} | ${e.agreement} | ${e.weight} | [${cellText(e.title)}](${e.relPath}) | ${e.author} | ${source} |`);
    }
  } else lines.push("_No sources yet. Add one with `npm run advisor -- source <url>`._");
  return `${lines.join("\n")}\n`;
}

/** The writers in the private data: its directories that have `posts/`. */
export function writers(corpusRoot: string = CORPUS_DIR): string[] {
  const dir = privateDir(corpusRoot);
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir, { withFileTypes: true })
    .filter((d) => d.isDirectory() && fs.existsSync(path.join(dir, d.name, "posts")))
    .map((d) => d.name)
    .sort(codePointCompare);
}

/** Write every index, or only `slug`'s. Returns a line per file written. */
export function buildIndexes(slug: string | undefined, corpusRoot: string = CORPUS_DIR): string[] {
  const report: string[] = [];
  for (const writer of slug === undefined ? writers(corpusRoot) : [slug]) {
    const text = renderWriterIndex(writer, corpusRoot);
    if (text === null) continue;
    fs.writeFileSync(path.join(dataDir(writer, corpusRoot), "INDEX.md"), text);
    report.push(`${writer}: INDEX.md written`);
  }
  if (slug !== undefined) return report;
  for (const [name, render] of [["thoughts", renderThoughtsIndex], ["library", renderLibraryIndex]] as const) {
    const text = render(corpusRoot);
    if (text === null) continue;
    fs.writeFileSync(path.join(privateDir(corpusRoot), name, "INDEX.md"), text);
    report.push(`${name}: INDEX.md written`);
  }
  return report;
}
