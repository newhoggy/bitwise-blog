dist/
.visual/
theme/build.js
node_modules/
.DS_Store
# Private pages: plaintext never leaves this machine; keys live in 1Password (see contracts/private-pages.md).
docs/*.private.html
_site/

# Skill eval results (claude plugin eval): regenerated on every run
.claude/skills/*/evals/results/
# Output of npm run skill-evals (the scheduled run uploads record.json as an artifact instead)
skill-evals/

# Anatomy figures: standalone pages are an intermediate; the published copy is the page in docs/
figures/*/*.html
.claude/skills/anatomy/examples/**/*.html
.claude/skills/anatomy/examples/**/*.pdf

# Everything derived from a writer's text: a symlink to a clone of the private data repo, or a plain directory.
# No trailing slash: `corpus/private/` would not match a symlink, and git would then track it.
corpus/private
# Only each writer's sources.yaml is committed. Posts synced before the private data existed stay ignored too.
corpus/*/posts/
