{
  "name": "beautiful-html",
  "private": true,
  "license": "(MIT AND CC-BY-4.0)",
  "type": "module",
  "description": "Bitwise Engineering: a software engineering blog, built on the beautiful-html theme.",
  "repository": "github:newhoggy/bitwise-blog",
  "homepage": "https://bitwise.john-ky.io/",
  "bh": { "siteName": "Bitwise Engineering", "repoUrl": "https://github.com/newhoggy/bitwise-blog", "discussionCategory": "general" },
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test --test-timeout=180000 tests/*.test.mts",
    "typecheck": "tsc -p .",
    "new": "node scripts/bh.mts new",
    "index": "node scripts/bh.mts index",
    "check": "node scripts/bh.mts check",
    "cards": "node scripts/bh.mts cards",
    "bundle": "node scripts/bh.mts bundle",
    "bundle:all": "node scripts/bh.mts bundle --all",
    "seal": "node scripts/bh.mts seal",
    "unseal": "node scripts/bh.mts unseal",
    "serve": "node scripts/bh.mts serve",
    "visual": "node scripts/visual.mts",
    "a11y": "node scripts/a11y.mts",
    "stats": "node scripts/stats.mts",
    "links": "node scripts/links.mts",
    "sync-posts": "node scripts/sync-posts.mts",
    "advisor": "node scripts/advisor.mts",
    "hooks": "git config core.hooksPath .githooks",
    "lint-skills": "node .claude/skills/skill-authoring/scripts/lint-skill.mjs --all",
    "trigger-evals": "node .claude/skills/skill-authoring/scripts/run-trigger-evals.mjs",
    "skill-evals": "node scripts/skill-evals.mts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/turndown": "5.0.6",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "turndown": "7.2.5",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
